{
	"manifest_version": 3,
	"name": "shit.so — give a shit",
	"version": "0.1.0",
	"description": "See how much shit people on X actually are. Vote with one of ten emojis.",
	"icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
	"content_scripts": [
		{
			"matches": ["https://x.com/*", "https://twitter.com/*"],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_idle"
		}
	],
	"host_permissions": ["https://shit.so/*", "https://shitso.vercel.app/*"]
}
