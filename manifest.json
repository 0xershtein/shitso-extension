{
	"manifest_version": 3,
	"name": "shit.so — give a shit",
	"version": "0.2.5",
	"description": "Give a shit to anyone on X without leaving the feed. One account, one vote per person.",
	"icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
	"permissions": ["storage"],
	"host_permissions": ["https://shit.so/*", "https://shitso.vercel.app/*"],
	"background": { "service_worker": "background.js" },
	"action": { "default_popup": "popup.html", "default_title": "shit.so" },
	"content_scripts": [
		{
			"matches": ["https://x.com/*", "https://twitter.com/*"],
			"js": ["content.js"],
			"css": ["content.css"],
			"run_at": "document_idle"
		}
	]
}
